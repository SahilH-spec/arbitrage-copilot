# ============================================================
# ARBITRAGE COPILOT — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (Railway PostgreSQL — auto-provided on Railway)
DATABASE_URL=postgresql://user:password@localhost:5432/arbitrage_copilot

# ============================================================
# AI — Anthropic Claude
# Get your key at: https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# AMAZON SELLING PARTNER API
# Set up at: https://sellercentral.amazon.com/apps/manage
# ============================================================
AMAZON_SP_APP_ID=amzn1.sp.solution...
AMAZON_SP_CLIENT_SECRET=...
AMAZON_SP_REFRESH_TOKEN=Atzr|...
AMAZON_SELLER_ID=...
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER  # US marketplace

# ============================================================
# KEEPA API
# Get your key at: https://keepa.com/#!api
# ============================================================
KEEPA_API_KEY=...

# ============================================================
# BRAVE SEARCH API (for market/product research)
# Get your key at: https://api.search.brave.com
# Free tier: 2,000 queries/month
# ============================================================
BRAVE_SEARCH_API_KEY=BSA...

# ============================================================
# PLAID (business bank connection)
# Get keys at: https://dashboard.plaid.com
# ============================================================
PLAID_CLIENT_ID=...
PLAID_SECRET=...
PLAID_ENV=sandbox  # sandbox | development | production

# ============================================================
# OPTIONAL: Managed Agent (Anthropic-hosted research agent)
# Created via agent-config/ — see that folder's README
# ============================================================
MANAGED_AGENT_ID=agent_...
MANAGED_ENV_ID=env_...

# ============================================================
# OPTIONAL: Email notifications for reports
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
REPORT_EMAIL=your-email@gmail.com

# ============================================================
# SECURITY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================
SESSION_SECRET=change-me-to-random-64-char-hex-string
JWT_SECRET=change-me-to-another-random-64-char-hex-string

# ============================================================
# AGENT DEFAULTS (can be changed via app UI)
# ============================================================
AGENT_RUN_SCHEDULE="0 4 * * *"  # 4 AM daily
AGENT_MAX_PRODUCTS=20
AGENT_MIN_ROI=30
AGENT_MIN_MONTHLY_SALES=30
